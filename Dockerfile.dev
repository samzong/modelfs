# Dockerfile for local development (make docker-build)
# This Dockerfile builds the binary inside Docker using multi-stage build
FROM --platform=$BUILDPLATFORM golang:1.25 AS builder
ARG TARGETOS=linux
ARG TARGETARCH
ARG BUILDPLATFORM

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# Cache deps before building and copying source
RUN go mod download

# Copy source code
COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

RUN commit="${COMMIT}"; \
    if [ "${commit}" = "unknown" ]; then commit="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"; fi; \
    build_date="${DATE}"; \
    if [ "${build_date}" = "unknown" ]; then build_date="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; fi; \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${commit} -X main.date=${build_date}" \
    -trimpath \
    -a -o ./manager ./main.go

# Use distroless as minimal base image to package the manager binary
# Refer to https://github.com/GoogleContainerTools/distroless for more details
FROM gcr.io/distroless/static:nonroot
ARG TARGETPLATFORM
ARG TARGETARCH

WORKDIR /app

# Copy binary from builder stage
COPY --from=builder /workspace/manager /app/manager

USER 65532:65532

ENTRYPOINT ["/app/manager"]

